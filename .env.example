# PRECIARIO_NVDA — copiar a .env y completar. No commitear .env
# Ver INSTALL.md, PROYECTO_NVDA.md e INDICADORES.md

# ── IBKR ──
# runtime=tws usa 7497 paper / 7496 live.
# runtime=gateway usa 4002 paper / 4001 live.
IBKR_RUNTIME=tws
# En Ubuntu nativo con TWS/Gateway local: 127.0.0.1. En WSL se detecta solo.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
IBKR_INTRADIA_CLIENT_ID=20
IBKR_INTRADIA_TIMEOUT=90

# ── INTRADIA / DAY TRADING (velas 1 hora) ──
INTRADAY_BAR_SIZE=1 hour
INTRADAY_DURATION_PER_REQ=1 M
INTRADAY_RECENT_DURATION=2 D
INTRADAY_MONTHS_BACK=12
INTRADAY_USE_RTH=1
INTRADAY_WHAT_TO_SHOW=TRADES
INTRADAY_BARS_PER_DAY=7

# ── Noticias / sentimiento (Alpha Vantage via companero) ──
ALPHAVANTAGE_API_KEY=TU_KEY_AQUI
# El CSV real de tu companero esta en core/output/news_history/news.csv.
# Se puede reemplazar por una ruta relativa/absoluta propia.
# NEWS_ARTICLES_PATH=core/output/news_history/news.csv
# NEWS_DAILY_PATH=data/news_nvda_daily.csv
NEWS_WINDOWS_H=6,24,72,168,720
NEWS_HALF_LIFE_H=12
MODEL_SENT_RELEVANCE_MIN=0.3

# ── Modelo / Target day trading ──
# Target validado 2026-09-20: H=4 barras, tau fijo 0.8% (balance 49/28/23)
# Ver resultados.md secciones 2-4.
MODEL_HORIZON_BARS=4
# Target: retorno simple (default) o logaritmico sobre adj_close/Close
MODEL_TARGET_MODE=simple
MODEL_TAU_MODE=fixed
MODEL_TAU_PCT=0.8
MODEL_TAU_K=0.5
MODEL_TAU_MIN=0.003
MODEL_TAU_MAX=0.02
MODEL_PURGE_BARS=4
MODEL_EMBARGO_BARS=7
# 0 = excluir del modelo (ver resultados.md): patrones binarios y conteos de noticias
MODEL_USE_PATTERNS=0
MODEL_USE_NEWS_COUNTS=0
MODEL_RSI_PERIOD=14
MODEL_SMA_PERIODS=20,50
MODEL_BB_PERIOD=20
MODEL_ATR_PERIOD=14
MODEL_BETA_WINDOW=60

# ── Bot / alertas ──
NVDA_WEBHOOK_ENABLED=0
NVDA_WEBHOOK_URL=
SIGNAL_PROBA_THRESHOLD=0.40
BOT_RUN_MINUTE_WINDOW=5
BOT_POLL_SECONDS=60
BOT_DRY_RUN=1

# ── Base de datos remota (Aiven PostgreSQL) — SOLO LECTURA ──
# Fuente de datos: auto (DB primero, CSV fallback) | db | csv
DATA_SOURCE=auto
# Perfil opcional: .env define APP_PROFILE y .env.{APP_PROFILE} sobreescribe.
# APP_PROFILE=prod
DB_HOST=pg-XXXXXXX.i.aivencloud.com
DB_PORT=25761
DB_NAME=nvidia_stock_market_db
DB_USER=avnadmin
DB_PASSWORD=TU_PASSWORD_AQUI
DB_DRIVER=PostgreSQL Unicode
DB_SSL=require
# DB_OHLCV_TIMEFRAME=intraday
# DB_CONNECT_TIMEOUT=10
